# Comma-separated API keys. IDs are assigned in order: key_1, key_2, ...
LLM_API_KEYS=replace_with_first_key,replace_with_second_key

# Any LiteLLM model identifier, e.g. gemini/gemini-3.5-flash
LLM_MODEL=gemini/gemini-3.5-flash

# SQLite location. Docker uses /data/app.db on a persistent named volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure header.
ENABLE_FAILURE_SIMULATION=true

# Backend URL baked into the frontend at build time.
VITE_API_URL=http://localhost:8000
